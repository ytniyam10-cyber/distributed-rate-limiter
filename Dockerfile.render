# Stage 1: Build the Spring Boot JAR
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

# Stage 2: Redis + Spring Boot in one container (demo deployment only)
FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache redis
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
EXPOSE 10000
CMD ["sh", "-c", "redis-server --daemonize yes --save '' --appendonly no --maxmemory 64mb --maxmemory-policy allkeys-lru && exec java -XX:MaxRAMPercentage=60 -Dserver.port=${PORT:-8080} -jar app.jar"]